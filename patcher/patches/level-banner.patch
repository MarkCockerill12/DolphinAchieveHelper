+#ifdef USE_RETRO_ACHIEVEMENTS
+// Lists the achievements that can be earned where the player just arrived, for a few seconds,
+// so ones that would only appear once primed or unlocked can be seen beforehand. Stacks above
+// the challenge indicators and leaderboard trackers. Caller holds the AchievementManager lock.
+void OnScreenUI::DrawLevelAchievements(float bottom_y)
+{
+  constexpr float FADE_IN_SECONDS = 0.3f;
+  constexpr float FADE_OUT_SECONDS = 1.0f;
+  constexpr size_t MAX_ROWS = 8;
+
+  const auto banner = RetroAchievements::LocationTracker::GetInstance().GetBanner();
+  if (!banner)
+  {
+    if (!m_level_texture_map.empty())
+      m_level_texture_map.clear();
+    return;
+  }
+  if (banner->serial != m_level_banner_serial)
+  {
+    m_level_banner_serial = banner->serial;
+    m_level_texture_map.clear();
+  }
+
+  auto& instance = AchievementManager::GetInstance();
+  const auto& challenges = instance.GetActiveChallenges();
+
+  std::vector<const rc_client_achievement_t*> rows;
+  for (const u32 id : banner->ids)
+  {
+    // A primed challenge already shows with its own label.
+    if (challenges.contains(id))
+      continue;
+    // Skip anything unlocked since the banner went up.
+    const auto* info = instance.GetAchievementInfo(id);
+    if (info == nullptr || info->state != RC_CLIENT_ACHIEVEMENT_STATE_ACTIVE)
+      continue;
+    rows.push_back(info);
+  }
+  if (rows.empty())
+    return;
+
+  const float elapsed =
+      std::chrono::duration<float>(std::chrono::steady_clock::now() - banner->start).count();
+  const float alpha = std::clamp(std::min(elapsed / FADE_IN_SECONDS,
+                                          (banner->duration.count() - elapsed) / FADE_OUT_SECONDS),
+                                 0.0f, 1.0f);
+
+  const float scale = ImGui::GetIO().DisplaySize.y / 1024.0f;
+  const float icon_size = 40.0f * scale;
+  const float text_width = 22.0f * ImGui::GetFontSize();
+  const ImVec4 heading_color(1.0f, 0.84f, 0.0f, 1.0f);
+  const ImVec4 description_color(0.72f, 0.76f, 0.84f, 1.0f);
+  const ImVec4 note_color(0.6f, 0.6f, 0.6f, 1.0f);
+
+  ImGui::PushStyleVar(ImGuiStyleVar_Alpha, alpha);
+  ImGui::SetNextWindowSize(ImVec2(0, 0));
+  ImGui::SetNextWindowPos(ImVec2(ImGui::GetIO().DisplaySize.x, bottom_y), 0, ImVec2(1, 1));
+  if (ImGui::Begin("LevelAchievements", nullptr,
+                   ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoInputs |
+                       ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                       ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoNav |
+                       ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoFocusOnAppearing))
+  {
+    ImGui::TextColored(heading_color, "Achievements in this level");
+
+    const size_t shown = std::min(rows.size(), MAX_ROWS);
+    for (size_t i = 0; i < shown; ++i)
+    {
+      const rc_client_achievement_t* info = rows[i];
+      ImGui::Spacing();
+
+      auto& [source, texture] = m_level_texture_map[info->id];
+      const auto& icon = instance.GetAchievementBadge(info->id, true);
+      if (source != icon.data.data() && icon.width > 0 && icon.height > 0)
+      {
+        TextureConfig tex_config(icon.width, icon.height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                                 AbstractTextureType::Texture_2DArray);
+        texture = g_gfx->CreateTexture(tex_config);
+        texture->Load(0, icon.width, icon.height, icon.width, icon.data.data(),
+                      sizeof(u32) * icon.width * icon.height);
+        source = icon.data.data();
+      }
+      if (texture)
+      {
+        ImGui::Image(*texture.get(), ImVec2(icon_size, icon_size));
+        ImGui::SameLine();
+      }
+
+      ImGui::BeginGroup();
+      ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + text_width);
+      ImGui::Text("%s (%u)", info->title, info->points);
+      ImGui::PushStyleColor(ImGuiCol_Text, description_color);
+      ImGui::TextUnformatted(info->description);
+      ImGui::PopStyleColor();
+      ImGui::PopTextWrapPos();
+      ImGui::EndGroup();
+    }
+    if (rows.size() > shown)
+      ImGui::TextColored(note_color, "+%zu more", rows.size() - shown);
+  }
+  ImGui::End();
+  ImGui::PopStyleVar();
+}
+#endif  // USE_RETRO_ACHIEVEMENTS
+
 void OnScreenUI::Finalize()
 {
   auto lock = GetImGuiLock();
