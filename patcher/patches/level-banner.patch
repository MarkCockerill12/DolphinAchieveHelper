+void LocationTracker::Reset()
+{
+  m_game = nullptr;
+  m_candidates.clear();
+  m_candidate_index.clear();
+  m_keys.clear();
+  m_located.clear();
+  m_reading.clear();
+  m_matches.clear();
+  m_stable_frames = 0;
+  m_settled.reset();
+  m_last_shown.clear();
+  m_seen_nonzero = false;
+
+  std::lock_guard lg{m_banner_mutex};
+  m_banner.reset();
+}
+
+size_t LocationTracker::AddCandidate(const rc_operand_t& operand)
+{
+  const std::pair<const void*, u8> id{operand.value.memref, operand.size};
+  if (const auto it = m_candidate_index.find(id); it != m_candidate_index.end())
+    return it->second;
+
+  Key key{};
+  key.operand = operand;
+  key.operand.type = RC_OPERAND_ADDRESS;
+
+  const rc_memref_t* memref = operand.value.memref;
+  if (memref->value.memref_type == RC_MEMREF_TYPE_MODIFIED_MEMREF)
+  {
+    const auto* modified = reinterpret_cast<const rc_modified_memref_t*>(memref);
+    key.chain = {modified->parent.value.memref, modified->parent.type};
+    key.offset = modified->modifier.value.num;
+  }
+  else
+  {
+    key.chain = {nullptr, 0};
+    key.offset = memref->address;
+  }
+
+  m_candidates.push_back(std::move(key));
+  m_candidate_index.emplace(id, m_candidates.size() - 1);
+  return m_candidates.size() - 1;
+}
+
+// Pull every location constraint out of one condition group.
+//
+// Conditions are handled a chain at a time: AndNext/OrNext links plus the condition that ends
+// them. A chain ending in a plain requirement must be true; one ending in ResetIf/PauseIf must be
+// false. Location shows up in both shapes:
+//   0xG20=1164404563                  "is EggStarGalaxy"
+//   R:0xG40!=3                        "reset unless mission 3"
+//   N:0xG40!=1_R:0xG40!=4             "reset unless mission 1 or 4"
+//   O:0xH10=2_0xH10=5                 "stage 2 or 5"
+// Chains with hit counting or ResetNextIf are stateful and are skipped rather than guessed at.
+void LocationTracker::ExtractConstraints(const rc_condset_t* condset,
+                                         std::vector<Constraint>& out)
+{
+  std::vector<const rc_condition_t*> links;
+  for (const rc_condition_t* cond = condset->conditions; cond != nullptr; cond = cond->next)
+  {
+    switch (cond->type)
+    {
+    case RC_CONDITION_ADD_ADDRESS:
+    case RC_CONDITION_ADD_SOURCE:
+    case RC_CONDITION_SUB_SOURCE:
+    case RC_CONDITION_REMEMBER:
+      // Already folded into the operand of the condition they feed.
+      continue;
+    case RC_CONDITION_AND_NEXT:
+    case RC_CONDITION_OR_NEXT:
+    case RC_CONDITION_RESET_NEXT_IF:
+    case RC_CONDITION_ADD_HITS:
+    case RC_CONDITION_SUB_HITS:
+      links.push_back(cond);
+      continue;
+    default:
+      break;
+    }
+
+    std::vector<const rc_condition_t*> terms = std::move(links);
+    links.clear();
+    const size_t num_links = terms.size();
+    terms.push_back(cond);
+
+    bool all_and = true;
+    bool all_or = true;
+    bool stateful = false;
+    for (size_t i = 0; i < num_links; ++i)
+    {
+      all_and &= terms[i]->type == RC_CONDITION_AND_NEXT;
+      all_or &= terms[i]->type == RC_CONDITION_OR_NEXT;
+      stateful |= terms[i]->type != RC_CONDITION_AND_NEXT && terms[i]->type != RC_CONDITION_OR_NEXT;
+    }
+    if (stateful)
+      continue;
+
+    // A hit target on a link makes the chain stateful; the final condition may carry one
+    // ("15 times while in stage X" still needs stage X).
+    const auto usable = [cond](const rc_condition_t* term, u8 oper) {
+      return term->oper == oper && IsLocationRead(term->operand1) &&
+             term->operand2.type == RC_OPERAND_CONST &&
+             (term == cond || term->required_hits == 0);
+    };
+    const auto single = [this](const rc_condition_t* term) {
+      Constraint c;
+      c.alts.push_back({AddCandidate(term->operand1), {term->operand2.value.num}});
+      c.delta = term->operand1.type == RC_OPERAND_DELTA;
+      return c;
+    };
+    // Every term as one "any of" constraint, merging terms that read the same key.
+    const auto any_of = [this, &terms]() {
+      Constraint c;
+      c.delta = true;
+      for (const rc_condition_t* term : terms)
+      {
+        const size_t key = AddCandidate(term->operand1);
+        auto it = std::find_if(c.alts.begin(), c.alts.end(),
+                               [key](const Alternative& a) { return a.key == key; });
+        if (it == c.alts.end())
+          c.alts.push_back({key, {term->operand2.value.num}});
+        else
+          it->values.insert(term->operand2.value.num);
+        c.delta &= term->operand1.type == RC_OPERAND_DELTA;
+      }
+      return c;
+    };
+    const auto all_usable = [&terms, &usable](u8 oper) {
+      return std::all_of(terms.begin(), terms.end(),
+                         [&](const rc_condition_t* t) { return usable(t, oper); });
+    };
+
+    if (IsRequirement(cond->type))
+    {
+      if (all_and)
+      {
+        // Every term must hold, so each equality is a constraint by itself.
+        for (const rc_condition_t* term : terms)
+        {
+          if (usable(term, RC_OPERATOR_EQ))
+            out.push_back(single(term));
+        }
+      }
+      else if (all_or && all_usable(RC_OPERATOR_EQ))
+      {
+        out.push_back(any_of());
+      }
+    }
+    else if (IsNegation(cond->type))
+    {
+      if (all_or)
+      {
+        // not (a or b) == not a and not b: each inequality is a constraint by itself.
+        for (const rc_condition_t* term : terms)
+        {
+          if (usable(term, RC_OPERATOR_NE))
+            out.push_back(single(term));
+        }
+      }
+      else if (all_and && all_usable(RC_OPERATOR_NE))
+      {
+        // not (a != x and b != y) == a == x or b == y
+        Constraint c = any_of();
+        c.windows = std::all_of(c.alts.begin(), c.alts.end(),
+                                [](const Alternative& a) { return a.values.size() == 1; });
+        out.push_back(std::move(c));
+      }
+    }
+  }
+}
+
+// Merge one group's constraints over the selected keys into its fingerprint.
+LocationTracker::Group LocationTracker::ToFingerprint(const std::vector<Constraint>& raw,
+                                                      const std::vector<int>& remap) const
+{
+  // Single-key constraints, intersected per key. Live and delta reads are kept apart: when they
+  // disagree the achievement is about moving from one place to another ("reach B without a
+  // launch star") and the place it starts from is where it is worth knowing about.
+  std::map<std::pair<size_t, bool>, ValueSet> singles;
+  std::vector<Constraint> multi;
+
+  const auto add_single = [&singles](size_t key, bool delta, const ValueSet& values) {
+    auto [it, inserted] = singles.try_emplace({key, delta}, values);
+    if (!inserted)
+    {
+      ValueSet both;
+      std::set_intersection(it->second.begin(), it->second.end(), values.begin(), values.end(),
+                            std::inserter(both, both.end()));
+      it->second = std::move(both);
+    }
+  };
+
+  for (const Constraint& constraint : raw)
+  {
+    Constraint mapped = constraint;
+    bool all_known = true;
+    for (Alternative& alt : mapped.alts)
+    {
+      const int key = remap[alt.key];
+      all_known &= key >= 0;
+      alt.key = static_cast<size_t>(key);
+    }
+    // An alternative on a key that is not a location could be the one that holds, so the
+    // constraint says nothing about location.
+    if (!all_known)
+      continue;
+
+    bool split = mapped.windows && IsStrong(mapped);
+    if (split)
+    {
+      const auto [lo, hi] = std::minmax_element(
+          mapped.alts.begin(), mapped.alts.end(), [this](const Alternative& a, const Alternative& b) {
+            return m_keys[a.key].offset < m_keys[b.key].offset;
+          });
+      split = m_keys[hi->key].offset - m_keys[lo->key].offset <= MAX_WINDOW_SPAN;
+    }
+    if (mapped.alts.size() == 1 || split)
+    {
+      for (const Alternative& alt : mapped.alts)
+        add_single(alt.key, mapped.delta, alt.values);
+    }
+    else
+    {
+      multi.push_back(std::move(mapped));
+    }
+  }
+
+  std::vector<Constraint> result;
+  for (const auto& [slot, values] : singles)
+  {
+    const auto [key, delta] = slot;
+    ValueSet chosen = values;
+    if (delta)
+    {
+      if (singles.contains({key, false}))
+        continue;  // handled with the live read below
+    }
+    else if (const auto it = singles.find({key, true}); it != singles.end())
+    {
+      ValueSet both;
+      std::set_intersection(values.begin(), values.end(), it->second.begin(), it->second.end(),
+                            std::inserter(both, both.end()));
+      chosen = both.empty() ? it->second : std::move(both);
+    }
+    if (chosen.empty())
+      return std::nullopt;
+
+    Constraint c;
+    c.alts.push_back({key, std::move(chosen)});
+    result.push_back(std::move(c));
+  }
+  for (Constraint& c : multi)
+    result.push_back(std::move(c));
+  return result;
+}
+
+void LocationTracker::Build(rc_client_t* client)
+{
+  Reset();
+  m_game = client->game;
+
+  std::vector<const rc_client_achievement_t*> infos;
+  std::vector<std::vector<std::vector<Constraint>>> raw;
+  for (const rc_client_subset_info_t* subset = client->game->subsets; subset != nullptr;
+       subset = subset->next)
+  {
+    for (u32 i = 0; i < subset->public_.num_achievements; ++i)
+    {
+      const rc_client_achievement_info_t& achievement = subset->achievements[i];
+      if (achievement.trigger == nullptr)
+        continue;
+
+      std::vector<std::vector<Constraint>> groups;
+      if (achievement.trigger->requirement != nullptr)
+        ExtractConstraints(achievement.trigger->requirement, groups.emplace_back());
+      else
+        groups.emplace_back();
+      for (const rc_condset_t* alt = achievement.trigger->alternative; alt != nullptr;
+           alt = alt->next)
+      {
+        ExtractConstraints(alt, groups.emplace_back());
+      }
+
+      for (const auto& group : groups)
+      {
+        for (const Constraint& constraint : group)
+        {
+          for (const Alternative& alt : constraint.alts)
+          {
+            Key& key = m_candidates[alt.key];
+            key.values.insert(alt.values.begin(), alt.values.end());
+            key.achievements.insert(achievement.public_.id);
+          }
+        }
+      }
+      infos.push_back(&achievement.public_);
+      raw.push_back(std::move(groups));
+    }
+  }
+
+  // The pointer chain whose reads discriminate the most: that is where the game keeps its
+  // "where am I". It degenerates to plain addresses for games with a flat stage variable.
+  std::map<std::pair<const void*, u8>, double> chain_score;
+  for (const Key& key : m_candidates)
+  {
+    if (key.values.size() >= 2)
+      chain_score[key.chain] += key.Score();
+  }
+  if (chain_score.empty())
+  {
+    INFO_LOG_FMT(ACHIEVEMENTS, "Location tracker: this set has no location reads.");
+    return;
+  }
+  const auto best = std::max_element(chain_score.begin(), chain_score.end(),
+                                     [](const auto& a, const auto& b) { return a.second < b.second; })
+                        ->first;
+
+  // Every read on that chain that ever takes two or more values can narrow down where the
+  // player is; the ones with enough values to name a place by themselves are "strong".
+  std::vector<int> remap(m_candidates.size(), -1);
+  bool any_strong = false;
+  for (size_t i = 0; i < m_candidates.size(); ++i)
+  {
+    if (m_candidates[i].chain != best || m_candidates[i].values.size() < 2)
+      continue;
+    Key key = m_candidates[i];
+    key.strong = key.values.size() >= MIN_STRONG_VALUES;
+    any_strong |= key.strong;
+    remap[i] = static_cast<int>(m_keys.size());
+    m_keys.push_back(std::move(key));
+  }
+  if (!any_strong)
+  {
+    INFO_LOG_FMT(ACHIEVEMENTS, "Location tracker: no read in this set identifies a place; off.");
+    m_keys.clear();
+    return;
+  }
+
+  for (size_t i = 0; i < infos.size(); ++i)
+  {
+    Located located{infos[i], {}};
+    bool has_location = false;
+    for (const auto& group : raw[i])
+    {
+      Group fingerprint = ToFingerprint(group, remap);
+      has_location |= fingerprint.has_value() && !fingerprint->empty();
+      located.groups.push_back(std::move(fingerprint));
+    }
+    if (has_location)
+      m_located.push_back(std::move(located));
+  }
+
+  INFO_LOG_FMT(ACHIEVEMENTS, "Location tracker: {} keys, {} of {} achievements have a location.",
+               m_keys.size(), m_located.size(), infos.size());
+  for (const Key& key : m_keys)
+  {
+    DEBUG_LOG_FMT(ACHIEVEMENTS, "  key +{:#x}{}: {} values, {} achievements", key.offset,
+                  key.strong ? " (strong)" : "", key.values.size(), key.achievements.size());
+  }
+}
+
+bool LocationTracker::IsStrong(const Constraint& constraint) const
+{
+  return std::all_of(constraint.alts.begin(), constraint.alts.end(),
+                     [this](const Alternative& a) { return m_keys[a.key].strong; });
+}
+
+bool LocationTracker::GroupMatches(const Group& group, const std::vector<u32>& current,
+                                   bool* strong) const
+{
+  *strong = false;
+  if (!group)
+    return false;
+  for (const Constraint& constraint : *group)
+  {
+    const bool holds =
+        std::any_of(constraint.alts.begin(), constraint.alts.end(), [&](const Alternative& a) {
+          return a.values.contains(current[a.key]);
+        });
+    if (!holds)
+      return false;
+    *strong |= IsStrong(constraint);
+  }
+  return true;
+}
+
+// A trigger needs its core group and, if it has alt groups, at least one of them. The
+// achievement belongs here when those groups' location constraints all hold and at least one
+// of them is on a strong key.
+bool LocationTracker::Matches(const Located& located, const std::vector<u32>& current) const
+{
+  bool strong = false;
+  if (!GroupMatches(located.groups[0], current, &strong))
+    return false;
+
+  if (located.groups.size() > 1)
+  {
+    bool some_alt_holds = false;
+    for (size_t i = 1; i < located.groups.size(); ++i)
+    {
+      bool alt_strong;
+      if (GroupMatches(located.groups[i], current, &alt_strong))
+      {
+        some_alt_holds = true;
+        strong |= alt_strong;
+      }
+    }
+    if (!some_alt_holds)
+      return false;
+  }
+  return strong;
+}
+
+// Locked achievements that belong to the current place, missables first, then by points.
+std::vector<u32> LocationTracker::FindMatches(const std::vector<u32>& current) const
+{
+  std::vector<const rc_client_achievement_t*> found;
+  for (const Located& located : m_located)
+  {
+    if (located.info->state == RC_CLIENT_ACHIEVEMENT_STATE_ACTIVE && Matches(located, current))
+      found.push_back(located.info);
+  }
+  std::stable_sort(found.begin(), found.end(), [](const auto* a, const auto* b) {
+    const bool a_missable = a->type == RC_CLIENT_ACHIEVEMENT_TYPE_MISSABLE;
+    const bool b_missable = b->type == RC_CLIENT_ACHIEVEMENT_TYPE_MISSABLE;
+    if (a_missable != b_missable)
+      return a_missable;
+    return a->points > b->points;
+  });
+
+  std::vector<u32> ids;
+  for (const auto* info : found)
+    ids.push_back(info->id);
+  return ids;
+}
+
+void LocationTracker::Update(rc_client_t* client)
+{
+  if (client == nullptr || client->game == nullptr)
+    return;
+  if (client->game != m_game)
+    Build(client);
+  if (m_keys.empty())
+    return;
+
+  std::vector<u32> reading(m_keys.size());
+  for (size_t i = 0; i < m_keys.size(); ++i)
+  {
+    rc_typed_value_t value;
+    rc_evaluate_operand(&value, &m_keys[i].operand, nullptr);
+    reading[i] = value.value.u32;
+  }
+
+  // Straight after boot RAM is still zeroed, and zero is a real place in plenty of games
+  // (the first stage), so wait until the game has written something.
+  if (!m_seen_nonzero)
+  {
+    if (std::all_of(reading.begin(), reading.end(), [](u32 v) { return v == 0; }))
+      return;
+    m_seen_nonzero = true;
+  }
+
+  // Settle on what matches rather than on the raw reading, so a value that keeps changing
+  // but decides nothing (a flag a few achievements test) cannot hold the banner back.
+  if (reading != m_reading)
+  {
+    m_reading = std::move(reading);
+    std::vector<u32> matches = FindMatches(m_reading);
+    if (matches != m_matches)
+    {
+      m_matches = std::move(matches);
+      m_stable_frames = 0;
+    }
+  }
+  if (m_stable_frames < SETTLE_FRAMES)
+  {
+    ++m_stable_frames;
+    return;
+  }
+  if (m_settled != m_matches)
+  {
+    m_settled = m_matches;
+    Settled(m_matches);
+  }
+}
+
+void LocationTracker::Settled(const std::vector<u32>& ids)
+{
+  std::lock_guard lg{m_banner_mutex};
+  if (ids.empty())
+  {
+    // Somewhere with nothing to show (a menu, a loading screen): coming back should show the
+    // list again.
+    m_last_shown.clear();
+    m_banner.reset();
+    return;
+  }
+
+  // Only when something new can be earned here. Unlocking one, or a flag narrowing the list,
+  // does not bring the banner back.
+  if (std::all_of(ids.begin(), ids.end(), [this](u32 id) { return m_last_shown.contains(id); }))
+    return;
+
+  std::string reading;
+  for (size_t i = 0; i < m_reading.size(); ++i)
+    reading += fmt::format("{}{:x}", i == 0 ? "" : " ", m_reading[i]);
+  INFO_LOG_FMT(ACHIEVEMENTS, "Location tracker: {} achievements here [{}]", ids.size(), reading);
+
+  m_last_shown = std::set<u32>(ids.begin(), ids.end());
+  const float seconds =
+      std::clamp(BANNER_BASE_SECONDS + BANNER_SECONDS_PER_ENTRY * ids.size(), BANNER_MIN_SECONDS,
+                 BANNER_MAX_SECONDS);
+  m_banner = Banner{ids, std::chrono::steady_clock::now(), std::chrono::duration<float>(seconds),
+                    ++m_banner_serial};
+}
+
+std::optional<LocationTracker::Banner> LocationTracker::GetBanner() const
+{
+  std::lock_guard lg{m_banner_mutex};
+  if (m_banner && std::chrono::steady_clock::now() - m_banner->start > m_banner->duration)
+    m_banner.reset();
+  return m_banner;
+}
+}  // namespace RetroAchievements
+
+#endif  // USE_RETRO_ACHIEVEMENTS
