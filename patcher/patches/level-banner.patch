+
+#pragma once
+
+#ifdef USE_RETRO_ACHIEVEMENTS
+
+#include <chrono>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include <rcheevos/include/rc_client.h>
+#include <rcheevos/include/rc_runtime_types.h>
+
+#include "Common/CommonTypes.h"
+
+namespace RetroAchievements
+{
+// Works out which achievements can be earned where the player is standing, so they can be
+// listed for a few seconds on arrival. Without this an achievement is only visible once it is
+// primed (a challenge indicator) or unlocked, so "do X in under 30 seconds" or "collect every
+// Y" gives no hint beforehand.
+//
+// Nothing here is game specific. The location is inferred from the achievement set itself:
+// the pointer chain (or flat memory) whose reads the most achievements compare against the
+// widest spread of constants is where the game keeps its "where am I" values - a stage id, a
+// stage name held as text, a mission number. An achievement belongs to the current place when
+// every one of its constraints on those values holds and at least one of them is on a value
+// with enough distinct settings to actually tell places apart.
+class LocationTracker
+{
+public:
+  struct Banner
+  {
+    std::vector<u32> ids;
+    std::chrono::steady_clock::time_point start;
+    std::chrono::duration<float> duration;
+    u64 serial = 0;
+  };
+
+  static LocationTracker& GetInstance();
+
+  // Call with the AchievementManager lock held, once per emulated frame after
+  // rc_client_do_frame, so the memory values it reads are the ones rcheevos just refreshed.
+  void Update(rc_client_t* client);
+  // Call with the AchievementManager lock held when the game is closed. The tracker keeps
+  // pointers into the loaded game, which rc_client frees on unload.
+  void Reset();
+
+  // Thread safe. The banner to draw right now, if one is still on screen.
+  std::optional<Banner> GetBanner() const;
+
+private:
+  LocationTracker() = default;
+
+  using ValueSet = std::set<u32>;
+
+  // A memory read that can tell the player's location apart.
+  struct Key
+  {
+    // A live (non-delta) copy of an operand that reads this key, for rc_evaluate_operand.
+    rc_operand_t operand;
+    // The read's pointer chain (its parent memref and access type), null for a flat address.
+    std::pair<const void*, u8> chain;
+    u32 offset;
+    ValueSet values;
+    std::set<u32> achievements;
+    // Takes enough distinct values to identify a place by itself.
+    bool strong = false;
+
+    double Score() const;
+  };
+
+  struct Alternative
+  {
+    size_t key;
+    ValueSet values;
+  };
+
+  // Satisfied when any alternative's key currently holds one of its values.
+  struct Constraint
+  {
+    std::vector<Alternative> alts;
+    // Read through delta values: "where the player was on the previous frame".
+    bool delta = false;
+    // Came from "reset unless a==x or b==y or ..." with one value per key. Set authors write
+    // "reset unless the level name is X" this way, splitting the name into 4-byte windows.
+    bool windows = false;
+  };
+
+  // A condition group's constraints; nullopt when they contradict so the group can never hold.
+  using Group = std::optional<std::vector<Constraint>>;
+
+  struct Located
+  {
+    const rc_client_achievement_t* info;
+    // Core group first, then each alt group.
+    std::vector<Group> groups;
+  };
+
+  void Build(rc_client_t* client);
+  size_t AddCandidate(const rc_operand_t& operand);
+  void ExtractConstraints(const rc_condset_t* condset, std::vector<Constraint>& out);
+  Group ToFingerprint(const std::vector<Constraint>& raw, const std::vector<int>& remap) const;
+  bool IsStrong(const Constraint& constraint) const;
+  bool GroupMatches(const Group& group, const std::vector<u32>& current, bool* strong) const;
+  bool Matches(const Located& located, const std::vector<u32>& current) const;
+  std::vector<u32> FindMatches(const std::vector<u32>& current) const;
+  void Settled(const std::vector<u32>& ids);
+
+  // Guarded by the AchievementManager lock.
+  const void* m_game = nullptr;
+  std::vector<Key> m_candidates;
+  std::map<std::pair<const void*, u8>, size_t> m_candidate_index;
+  std::vector<Key> m_keys;
+  std::vector<Located> m_located;
+  std::vector<u32> m_reading;
+  std::vector<u32> m_matches;
+  u32 m_stable_frames = 0;
+  std::optional<std::vector<u32>> m_settled;
+  std::set<u32> m_last_shown;
+  bool m_seen_nonzero = false;
+
+  mutable std::mutex m_banner_mutex;
+  mutable std::optional<Banner> m_banner;
+  u64 m_banner_serial = 0;
+};
+}  // namespace RetroAchievements
+
+#endif  // USE_RETRO_ACHIEVEMENTS
