+// A level's memory is briefly inconsistent while it loads (name written before the mission
+// index, pointers pointing at freed data), so what matches must hold this many frames first.
+constexpr u32 SETTLE_FRAMES = 45;
+
+// A value that identifies a place has to tell many places apart. One with only a handful of
+// settings is a state flag or a mission number; an achievement placed by that alone would show
+// in every level (the second mission of every galaxy, say), so it needs a stronger one too.
+constexpr size_t MIN_STRONG_VALUES = 5;
+
+// "Reset unless name window A or window B ..." is only read as "the name is A..B" when the
+// windows are this close together, i.e. plausibly parts of one field.
+constexpr u32 MAX_WINDOW_SPAN = 16;
+
+// On-screen time grows with the number of entries so there is time to read them.
+constexpr float BANNER_BASE_SECONDS = 4.0f;
+constexpr float BANNER_SECONDS_PER_ENTRY = 1.5f;
+constexpr float BANNER_MIN_SECONDS = 6.0f;
+constexpr float BANNER_MAX_SECONDS = 15.0f;
+
+// A plain read of memory, directly or through a pointer chain, that is not transformed or
+// combined with anything else. Delta reads count: while the player stays put the previous
+// frame's value is the current one.
+bool IsLocationRead(const rc_operand_t& operand)
+{
+  if (operand.type != RC_OPERAND_ADDRESS && operand.type != RC_OPERAND_DELTA)
+    return false;
+  // Integer sizes only; floats, MBF and doubles come after 32-bit big endian.
+  if (operand.size > RC_MEMSIZE_32_BITS_BE || operand.value.memref == nullptr)
+    return false;
+
+  const rc_memref_t* memref = operand.value.memref;
+  if (memref->value.memref_type == RC_MEMREF_TYPE_MEMREF)
+    return true;
+  if (memref->value.memref_type != RC_MEMREF_TYPE_MODIFIED_MEMREF)
+    return false;
+
+  // AddAddress chains become an indirect read; AddSource and friends become other modifiers,
+  // which fold several values together and are no use for telling where the player is.
+  const auto* modified = reinterpret_cast<const rc_modified_memref_t*>(memref);
+  return modified->modifier_type == RC_OPERATOR_INDIRECT_READ &&
+         modified->modifier.type == RC_OPERAND_CONST &&
+         rc_operand_is_memref(&modified->parent);
+}
+
+bool IsRequirement(u8 type)
+{
+  return type == RC_CONDITION_STANDARD || type == RC_CONDITION_TRIGGER ||
+         type == RC_CONDITION_MEASURED || type == RC_CONDITION_MEASURED_IF;
+}
+
+bool IsNegation(u8 type)
+{
+  return type == RC_CONDITION_RESET_IF || type == RC_CONDITION_PAUSE_IF;
+}
+}  // namespace
